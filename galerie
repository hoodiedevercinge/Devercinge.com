<!index.html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Devercinge — Galerie</title>
<style>
  :root{
    --bg: #0a0a12;
    --card: #171726;
    --ink: #f3f1ec;
    --ink-dim: #b8b6c8;
    --star: #e9eaf5;
    --gold: #e3b563;
    --line: #2a2a3d;
  }

  *{ margin:0; padding:0; box-sizing:border-box; }
  html{ scroll-behavior:smooth; }

  body{
    background:var(--bg);
    color:var(--ink);
    font-family:-apple-system, 'Inter', 'Segoe UI', sans-serif;
    max-width:480px;
    margin:0 auto;
    min-height:100vh;
    overflow-x:hidden;
  }

  .stars{
    position:fixed;
    top:0; left:0; right:0; bottom:0;
    overflow:hidden;
    z-index:0;
    max-width:480px;
    margin:0 auto;
  }
  .stars span{
    position:absolute;
    width:2px; height:2px;
    background:var(--star);
    border-radius:50%;
    opacity:.5;
    animation:twinkle 3.5s ease-in-out infinite;
  }
  @keyframes twinkle{ 0%,100%{opacity:.15;} 50%{opacity:.9;} }
  @media (prefers-reduced-motion: reduce){ .stars span{ animation:none; opacity:.4; } }

  header{
    position:relative;
    z-index:1;
    padding:56px 24px 28px;
    text-align:center;
  }

  .eyebrow{
    font-size:11px;
    letter-spacing:.3em;
    text-transform:uppercase;
    color:var(--gold);
    margin-bottom:14px;
  }

  h1{
    font-family:'Arial Black', 'Segoe UI Black', sans-serif;
    font-size:34px;
    text-transform:uppercase;
    letter-spacing:-.01em;
    color:var(--star);
    text-shadow:0 0 18px rgba(233,234,245,.35);
  }

  .tagline{
    margin-top:14px;
    color:var(--ink-dim);
    font-size:14px;
    line-height:1.6;
    padding:0 20px;
  }

  .gallery-wrap{
    position:relative;
    z-index:1;
    margin-top:12px;
  }

  .gallery{
    display:flex;
    overflow-x:auto;
